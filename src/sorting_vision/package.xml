<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sorting_vision</name>
  <version>0.1.0</version>
  <description>
    模块2 视觉感知：YOLO11-seg 实例分割检测节点 + 仿真合成数据自动生成 + 训练脚本。
    支持 classical 颜色分割后端，便于在模型训练完成前先打通闭环链路。
  </description>
  <maintainer email="dev@example.com">robot sorting dev</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>sorting_interfaces</exec_depend>
  <exec_depend>sorting_bringup</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>