<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sorting_bringup</name>
  <version>0.1.0</version>
  <description>
    系统级共享配置（类别定义 / 全局参数）与顶层 launch。
    同时提供各功能包共用的 YAML 配置加载工具。
  </description>
  <maintainer email="dev@example.com">robot sorting dev</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <!-- 注意：不声明 sorting_simulation 依赖（其已依赖本包，声明会构成环）。
       urdf_relay 节点运行时从同一工作区导入它，与本包 launch 引用其 launch 文件同理。 -->
  <exec_depend>rosbridge_server</exec_depend>
  <exec_depend>web_video_server</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>