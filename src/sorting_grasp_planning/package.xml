<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sorting_grasp_planning</name>
  <version>0.1.0</version>
  <description>
    模块4 抓取决策：由目标三维位姿与掩码主方向生成四段式抓取姿态
    （pre-grasp / grasp / lift / place），并对候选做可抓性筛选与评分。
  </description>
  <maintainer email="dev@example.com">robot sorting dev</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>tf_transformations</exec_depend>
  <exec_depend>sorting_interfaces</exec_depend>
  <exec_depend>sorting_bringup</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>