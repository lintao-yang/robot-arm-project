<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sorting_grasp_planning</name>
  <version>0.1.0</version>
  <description>
    模块4 抓取决策：复用预训练 GraspNet 推理 6DoF 抓取位姿，
    做宽度/接近方向过滤后发布 world 系抓取候选。
  </description>
  <maintainer email="dev@example.com">robot sorting dev</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sorting_interfaces</exec_depend>
  <exec_depend>sorting_bringup</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>