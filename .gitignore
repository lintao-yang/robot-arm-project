# ROS 2 构建产物
build/
install/
log/

# 运行时日志与录像
logs/
*.mp4

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# 项目 Python 虚拟环境（torch/sklearn 等，体积大，按 docs/UBUNTU_NATIVE_MIGRATION.md 重建）
.venv/

# 第三方依赖（graspnet-baseline 源码与权重，体积大，由 scripts 脚本按需拉取）
third_party/

# 训练模型权重（体积大，另行管理）
models/*.pt
models/*.onnx

# 训练产物 / 数据集 / 预训练权重（体积大，不随仓库分发，见 README 复现说明）
runs/
datasets/
weights/
*.pt
*.onnx

# 编辑器/系统
.vscode/
.idea/
.DS_Store
Thumbs.db
